# Konfigurations-Datenbank (MariaDB)
DB_HOST=mariadb.bcw-intern.local
DB_PORT=3306
DB_USER=[DB_BENUTZER]
DB_PASSWORD=[DB_PASSWORT]
DB_NAME=HochschulorgaApps
DB_CHARSET=utf8mb4
DB_SSL=true

# SQL Server DWH (Windows Auth)
MSSQL_HOST=ms-sql-107.bcw-intern.local,1433
MSSQL_DATABASE_DWH=BCW_DWH
MSSQL_DATABASE_STA=BCW_STA
MSSQL_DRIVER={ODBC Driver 17 for SQL Server}
MSSQL_TRUSTED_CONNECTION=yes
