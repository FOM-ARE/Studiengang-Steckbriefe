# Studiengang-Steckbriefe - Umgebungsvariablen
# Kopiere diese Datei als .env.development / .env.staging / .env.production
# und passe die Werte an die jeweilige Umgebung an.
# wsgi.py laedt automatisch die .env-Datei via python-dotenv.

# --- Umgebung ----------------------------------------------------------------
FLASK_CONFIG=development

# --- Flask --------------------------------------------------------------------
FLASK_SECRET_KEY=change-me-in-production

# --- DWH (SQL Server) --------------------------------------------------------
DWH_HOST=ms-sql-107.bcw-intern.local
DWH_PORT=1433
DWH_DATABASE=BCW_DWH
DWH_AUTHENTICATION=Windows

# --- MariaDB (Konfigurations-DB) ---------------------------------------------
DB_HOST=mariadb-dev.bcw-intern.local
DB_PORT=3306
DB_USER=HochschulorgaApps
DB_PASSWORD=
DB_NAME=HochschulorgaApps
DB_CHARSET=utf8mb4
DB_SSL=true

# --- Azure Credentials (Service Principal) ------------------------------------
# Gleicher SP fuer Key Vault und Entra ID.
# Umgebungsspezifische Variablen (DEV/STAGING/PROD) werden bevorzugt,
# generische als Fallback.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# --- Azure Key Vault ----------------------------------------------------------
AZURE_KEYVAULT_URL=

# --- Entra ID (Redirect) -----------------------------------------------------
ENTRA_REDIRECT_URI=http://localhost:5000/api/auth/callback

# --- CORS ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
